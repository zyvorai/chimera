# Chimera environment file — see internal/config/config.go for the full list.
# Uncomment and edit as needed; chimera falls back to its built-in defaults
# for anything left unset.

#CHIMERA_LISTEN=0.0.0.0:8989
#CHIMERA_PUBLIC_HOST=localhost:8989
#CHIMERA_PERSONA=vsphere
#CHIMERA_USERNAME=administrator@vsphere.local
#CHIMERA_PASSWORD=vmware
#CHIMERA_ADMIN_TOKEN=chimera-admin
#CHIMERA_VMS_PER_POOL=3
#CHIMERA_FIXTURE_SIZE_MB=16
#CHIMERA_FIXTURE_VMDK=/etc/chimera/fixtures/sample.vmdk
#CHIMERA_FIXTURE_VMDK_DIR=/etc/chimera/fixtures
# Personas: vsphere (default, Command Center), nutanix (/api/nutanix/v3), hyperv (/wsman)